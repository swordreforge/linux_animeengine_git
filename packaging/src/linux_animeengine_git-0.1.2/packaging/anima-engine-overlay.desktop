[Desktop Entry]
Type=Application
Version=1.0
Name=AnimaEngine Overlay
GenericName=Animated overlay
Comment=Show a .apng/.gif overlay anchored above other windows
Exec=anima-overlay %f
# A file handler, not a launcher: the overlay takes the animation to show, so it appears in
# "open with" and stays out of the application menu, where a click with no file does nothing.
MimeType=image/gif;image/apng;image/webp;image/png;
NoDisplay=true
TryExec=anima-overlay
Icon=anima-engine
Terminal=false
Categories=Graphics;
Keywords=anime;overlay;live2d;apng;gif;animation;
StartupNotify=false
